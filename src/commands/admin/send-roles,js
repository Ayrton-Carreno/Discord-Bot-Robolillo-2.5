const {
  ActionRowBuilder,
  ButtonBuilder,
  ButtonStyle,
  PermissionFlagsBits,
} = require('discord.js');

// Reemplaza estos IDs por los IDs reales de tus roles en Discord
const roles = [
  {
    id: '1530481358248612001',
    label: 'Arbolillo',
  },
  {
    id: '1400557591024894123',
    label: 'GOAT',
  },
  {
    id: '1573252814367629372',
    label: 'People',
  },
];

module.exports = {
  name: 'send-roles',
  description: 'Sends the role selection buttons.',
  permissionsRequired: [PermissionFlagsBits.Administrator],
  botPermissions: [PermissionFlagsBits.ManageRoles],
  callback: async (client, interaction) => {
    try {
      const row = new ActionRowBuilder();

      roles.forEach((role) => {
        row.components.push(
          new ButtonBuilder()
            .setCustomId(role.id)
            .setLabel(role.label)
            .setStyle(ButtonStyle.Primary)
        );
      });

      await interaction.channel.send({
        content: 'Claim or remove a role below.',
        components: [row],
      });

      await interaction.reply({
        content: 'Role buttons sent!',
        ephemeral: true,
      });
    } catch (error) {
      console.log(error);
    }
  },
};